#!/usr/bin/env bash
set -euo pipefail

msg_file="$1"
repo_root="$(git rev-parse --show-toplevel)"
version_file="${repo_root}/WEB_VERSION"
version="$(tr -d '[:space:]' < "${version_file}")"

if [[ ! "${version}" =~ ^[0-9]+$ ]]; then
  echo "WEB_VERSION must contain a numeric version" >&2
  exit 1
fi

first_line="$(head -n 1 "${msg_file}" || true)"

# The pre-commit hook is the source of truth. Normalize any manually supplied
# version prefix so commit history and WEB_VERSION cannot drift apart.
subject="${first_line}"
if [[ "${first_line}" =~ ^V[0-9]+([[:space:]]*[:\-][[:space:]]*|[[:space:]]+)(.*)$ ]]; then
  subject="${BASH_REMATCH[2]}"
fi

printf 'V%s: %s\n' "${version}" "${subject}" > "${msg_file}"
